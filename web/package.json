{
  "name": "hydra",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate-tanstack-router": "tsr generate",
    "generate-openapi": "openapi --input ../api/openapi.yaml --output src/api --client fetch --name Hydra",
    "generate-routes-regex": "node scripts/generate-routes-regex.ts",
    "prebuild": "npm run generate-openapi && npm run generate-tanstack-router",
    "build": "tsc -b && vite build",
    "postbuild": "npm run generate-routes-regex",
    "lint": "eslint .",
    "probe:rerenders": "node scripts/rerender-probe.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.60.0",
    "@tanstack/router-cli": "^1.167.21",
    "@tanstack/router-plugin": "^1.168.23",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "ffmpeg-static": "^5.3.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "openapi-typescript-codegen": "^0.31.0",
    "playwright": "1.60.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "vite": "^8.1.5"
  },
  "trustedDependencies": [
    "ffmpeg-static"
  ]
}

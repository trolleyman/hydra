{
  "name": "hydra",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate-tanstack-router": "tsr generate",
    "generate-openapi": "openapi --input ../api/openapi.yaml --output src/api --client fetch --name Hydra",
    "generate-routes-regex": "node scripts/generate-routes-regex.ts",
    "prebuild": "npm run generate-openapi && npm run generate-tanstack-router",
    "build": "tsc -b && vite build",
    "postbuild": "npm run generate-routes-regex",
    "typecheck": "tsc -b",
    "lint": "tsc -b && eslint .",
    "probe:rerenders": "node scripts/rerender-probe.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@tanstack/router-cli": "^1.167.21",
    "@tanstack/router-plugin": "^1.168.23",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "openapi-typescript-codegen": "^0.31.0",
    "playwright": "1.61.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "trustedDependencies": [
    "ffmpeg-static"
  ],
  "//typescript": "Held at 6.0.x, NOT bumped to 7.0. As of 2026-07-24 typescript-eslint (latest 8.65) caps its peer at 'typescript <6.1', and our eslint.config.js extends tseslint.configs.recommended, so 6.0 is the newest that lints - TS 7.0 (the native Go port) breaks `npm run lint`. Revisit 7.0 once typescript-eslint ships TS 7 support."
}

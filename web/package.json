{
  "name": "hydra",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build-fonts && vite",
    "generate-tanstack-router": "tsr generate",
    "generate-openapi": "openapi --input ../api/openapi.yaml --output src/api --client fetch --name Hydra",
    "generate-routes-regex": "node scripts/generate-routes-regex.ts",
    "build-fonts": "node scripts/build-fonts.ts",
    "prebuild": "npm run build-fonts && npm run generate-openapi && npm run generate-tanstack-router",
    "build": "tsc -b && vite build && node scripts/precompress.ts",
    "postbuild": "npm run generate-routes-regex",
    "typecheck": "tsc -b",
    "lint": "tsc -b && eslint .",
    "probe:rerenders": "node scripts/rerender-probe.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.46",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "refractor": "^5.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tldts": "^7.4.19",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "openapi-typescript-codegen": "^0.31.0",
    "playwright": "1.64.1",
    "subset-font": "^2.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "trustedDependencies": [
    "ffmpeg-static"
  ],
  "//package-manager": "Lifecycle scripts intentionally use `npm run`: npm executes them directly, while aube transparently redirects them to itself. Keep the package buildable with either `npm run <script>` or `aube run <script>`.",
  "//typescript": "Held at 6.0.x, NOT bumped to 7.0. typescript-eslint 8.72 caps its peer at 'typescript <6.1', and our eslint.config.js extends tseslint.configs.recommended, so 6.0 is the newest supported version. Revisit 7.0 once typescript-eslint ships TS 7 support."
}

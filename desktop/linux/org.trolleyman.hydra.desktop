[Desktop Entry]
Type=Application
Name=Hydra
Comment=Run and review AI coding agents
Exec=hydra-desktop %u
Icon=org.trolleyman.hydra
Terminal=false
Categories=Development;Utility;
StartupNotify=true
StartupWMClass=org.trolleyman.hydra
MimeType=x-scheme-handler/hydra;
Actions=NewWindow;NewChat;

[Desktop Action NewWindow]
Name=New window
Exec=hydra-desktop

[Desktop Action NewChat]
Name=New chat
Exec=hydra-desktop hydra://project-directory/_chat

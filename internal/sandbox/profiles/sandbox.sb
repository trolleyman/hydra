;; Sandbox profile: default-deny filesystem access, with launch-specific
;; readable/writable paths appended by Hydra.

(version 1)
(allow default)

;; Files are default-deny. Hydra appends explicit system, tool, worktree and
;; per-head state allowances for each launch.
(deny file-read*)
(deny file-write*)

;; Allow access within the immediate workspace root. A project-directory
;; read-only session receives a later write denial from the generated rules.
(allow file-read* file-write* (subpath (param "WORK_DIR")))

;; Essential device writes. Private temporary storage and provider state are
;; granted per launch by the generated rules.
(allow file-write*
    (literal "/dev/null")
    (literal "/dev/tty")
    (literal "/dev/dtracehelper"))
